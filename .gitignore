# Python cache directories
__pycache__/
*.pyc
*.pyo

modules/neovim/nvim/lazy-lock.json

# Defensive only: refresh rejects Git worktree destinations, but never stage a
# local plaintext cache or its temporary files if XDG_STATE_HOME is misdirected.
secrets.zsh
.secrets.zsh.*
.secrets.restore.*

.DS_Store
*.DS_Store

# Company-specific Claude commands (not for public repo)
modules/claude/commands/raft/
modules/claude/skills/rafty
modules/claude/commands/raft-*.md
modules/claude/agents/raft-*.md
modules/claude/hooks/peon-ping/
modules/claude/skills/peon-ping-*/

# Herdr-managed Claude integration artifacts
modules/claude/hooks/herdr-agent-state.sh

# Crush directory
.crush/

# Claude session snapshots (personal work state)
.claude/snapshots/

# OMP runtime state is ignored; project skills are repository-managed.
.omp/*
!.omp/skills/
!.omp/skills/**

# OMP advisory config locks follow managed symlinks into this module.
modules/omp/**/config.yml.lock

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
# Dependency directories
node_modules/
# Environment variables
.env
# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Task files
tasks.json

# Superpowers local state
.superpowers/
docs/superpowers/
