#!/usr/bin/env bash
# Omarchy theme-set hook, linked by mise.omarchy.toml; bootstrap.sh also runs it. Copies the k9s
# skin Omarchy rendered for the current theme to skins/current.yaml, the skin config.yaml names.
# The rename lands in the skins directory, which k9s's reactive mode watches, so open k9s
# sessions retint without a restart.
set -euo pipefail

src=$HOME/.local/state/omarchy/current/theme/k9s.yaml
dir=${XDG_CONFIG_HOME:-$HOME/.config}/k9s/skins
[ -f "$src" ] || exit 0

mkdir -p "$dir"
tmp=$(mktemp "$dir/.current.yaml.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cp "$src" "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$dir/current.yaml"
