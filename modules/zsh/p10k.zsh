# Powerlevel10k config, written by hand after the look of Tern's "Tern" prompt
# preset: separate rounded chips for the directory and git status, the clock
# on the right, and ❯ on its own line. Colors are Catppuccin Mocha; a chip's
# background is its text color at about 14% over the base (#1e1e2e), sampled
# from Tern's preset for the directory, git and clock chips.
#
# Not generated by `p10k configure`; running it would replace this file.

# Temporarily change options.
'builtin' 'local' '-a' 'p10k_config_opts'
[[ ! -o 'aliases'         ]] || p10k_config_opts+=('aliases')
[[ ! -o 'sh_glob'         ]] || p10k_config_opts+=('sh_glob')
[[ ! -o 'no_brace_expand' ]] || p10k_config_opts+=('no_brace_expand')
'builtin' 'setopt' 'no_aliases' 'no_sh_glob' 'brace_expand'

() {
  emulate -L zsh -o extended_glob

  # Start from a clean slate so `source ~/.p10k.zsh` applies edits.
  unset -m '(POWERLEVEL9K_*|DEFAULT_USER)~POWERLEVEL9K_GITSTATUS_DIR'

  # Zsh >= 5.1 is required.
  [[ $ZSH_VERSION == (5.<1->*|<6->.*) ]] || return

  typeset -g POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(
    dir_tail vcs   # line 1
    newline
    prompt_char    # line 2
  )
  # Only the clock shows all the time; the rest appear when they apply.
  typeset -g POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(
    status command_execution_time background_jobs direnv virtualenv
    kubecontext terraform aws context time
    newline
  )

  typeset -g POWERLEVEL9K_MODE=nerdfont-v3
  typeset -g POWERLEVEL9K_ICON_PADDING=none
  typeset -g POWERLEVEL9K_ICON_BEFORE_CONTENT=true
  typeset -g POWERLEVEL9K_PROMPT_ADD_NEWLINE=false
  typeset -g POWERLEVEL9K_MULTILINE_{FIRST,NEWLINE,LAST}_PROMPT_{PREFIX,SUFFIX}=
  typeset -g POWERLEVEL9K_MULTILINE_FIRST_PROMPT_GAP_CHAR=' '
  # No background unless a chip sets one (prompt_char would get black).
  typeset -g POWERLEVEL9K_BACKGROUND=
  # Earlier prompts collapse to ❯ and their command, like Tern's.
  typeset -g POWERLEVEL9K_TRANSIENT_PROMPT=always
  typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
  typeset -g POWERLEVEL9K_DISABLE_HOT_RELOAD=true

  ###################################[ chips ]###################################
  # p10k draws the separator between two segments in the previous segment's
  # color on the next one's background. Starting it with %k (no background)
  # leaves a clear one-column gap instead, and each chip's own whitespace
  # draws its rounded ends: both on the left; on the right the separator
  # draws the start and the whitespace the end.
  local l=$'\uE0B6' r=$'\uE0B4'  # half circles: a chip's left and right end
  typeset -g POWERLEVEL9K_{LEFT,RIGHT}_{LEFT,RIGHT}_WHITESPACE=
  typeset -g POWERLEVEL9K_LEFT_{SEGMENT,SUBSEGMENT}_SEPARATOR='%k '
  typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR="%k $l"
  typeset -g POWERLEVEL9K_RIGHT_PROMPT_FIRST_SEGMENT_START_SYMBOL=$l
  typeset -g POWERLEVEL9K_{LEFT_PROMPT_FIRST_SEGMENT_START,LEFT_PROMPT_LAST_SEGMENT_END,RIGHT_PROMPT_LAST_SEGMENT_END}_SYMBOL=

  # Segment (or segment_STATE), text color, chip background.
  local -a chips=(
    DIR_TAIL               '#cdd6f4' '#373849'
    VCS                    '#f9e2af' '#3c3840'
    TIME                   '#9399b2' '#2d2d3f'
    STATUS                 '#f38ba8' '#3c2d3f'
    STATUS_OK_PIPE         '#a6e3a1' '#313a3e'
    COMMAND_EXECUTION_TIME '#fab387' '#3d333a'
    BACKGROUND_JOBS        '#a6e3a1' '#313a3e'
    DIRENV                 '#f9e2af' '#3c3840'
    VIRTUALENV             '#94e2d5' '#2f3945'
    KUBECONTEXT            '#89b4fa' '#2d334b'
    TERRAFORM              '#cba6f7' '#36314a'
    AWS                    '#fab387' '#3d333a'
    CONTEXT                '#cdd6f4' '#373849'
    CONTEXT_ROOT           '#f38ba8' '#3c2d3f'
  )
  local name fg bg
  for name fg bg in $chips; do
    typeset -g POWERLEVEL9K_${name}_FOREGROUND=$fg POWERLEVEL9K_${name}_BACKGROUND=$bg
    typeset -g POWERLEVEL9K_${name}_LEFT_LEFT_WHITESPACE="%k%F{$bg}$l"
    typeset -g POWERLEVEL9K_${name}_{LEFT,RIGHT}_RIGHT_WHITESPACE="%k%F{$bg}$r"
    typeset -g POWERLEVEL9K_${name}_RIGHT_SUBSEGMENT_SEPARATOR="%k %F{$bg}$l"
  done

  ################################[ prompt_char ]################################
  typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='#a6e3a1'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='#f38ba8'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIINS_CONTENT_EXPANSION='❯'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VICMD_CONTENT_EXPANSION='❮'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIVIS_CONTENT_EXPANSION='V'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIOWR_CONTENT_EXPANSION='▶'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_OVERWRITE_STATE=true

  ##################################[ dir_tail ]##################################
  # The ~-relative path while it is at most four parts deep, else …/ and the
  # last three parts (…/stencil/crates/termview); the last part in bold. A
  # lock replaces the folder icon where the directory isn't writable.
  function prompt_dir_tail() {
    emulate -L zsh
    local p=${(%):-%~} lead= parent= tail
    if [[ $p == / ]]; then
      tail=/
    else
      local -a parts=(${(s:/:)p})
      [[ $p == /* ]] && lead=/
      if (( $#parts > 4 )); then
        lead='…/'
        parts=($parts[-3,-1])
      fi
      tail=$parts[-1]
      (( $#parts > 1 )) && parent=${(j:/:)parts[1,-2]}/
    fi
    local icon=$'\uF07C'
    [[ -w $PWD ]] || icon=$'\uF023'
    p10k segment -i $icon -t "$lead${parent//\%/%%}%B${tail//\%/%%}%b"
  }

  #####################################[ vcs ]####################################
  typeset -g POWERLEVEL9K_VCS_BRANCH_ICON='\uF126 '
  typeset -g POWERLEVEL9K_VCS_UNTRACKED_ICON='?'
  # The branch icon comes from the formatter; no repository-host icon.
  typeset -g POWERLEVEL9K_VCS_VISUAL_IDENTIFIER_EXPANSION=
  typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND='#6c7086'

  # Git status, e.g. "main ⇡2 !2 ?1": ⇣/⇡ behind/ahead of the upstream, ⇠/⇢
  # of the push remote, *stashes, ~conflicts, +staged, !unstaged, ?untracked.
  # Adapted from the formatter `p10k configure` generates. Everything takes
  # the chip's color except conflicts and in-progress actions (red); a stale
  # status ($1 == 0) stays in the loading grey throughout.
  function my_git_formatter() {
    emulate -L zsh

    if [[ -n $P9K_CONTENT ]]; then
      # "loading", or vcs_info output when gitstatus is unavailable.
      typeset -g my_git_format=$P9K_CONTENT
      return
    fi

    local text= alert=
    (( $1 )) && text='%F{#f9e2af}' alert='%F{#f38ba8}'
    local res

    if [[ -n $VCS_STATUS_LOCAL_BRANCH ]]; then
      local branch=${(V)VCS_STATUS_LOCAL_BRANCH}
      # Over 32 characters: the first 12 … the last 12.
      (( $#branch > 32 )) && branch[13,-13]="…"
      res+="${(g::)POWERLEVEL9K_VCS_BRANCH_ICON}${branch//\%/%%}"
    fi
    # The tag when not on a branch; the commit when there is neither.
    if [[ -n $VCS_STATUS_TAG && -z $VCS_STATUS_LOCAL_BRANCH ]]; then
      local tag=${(V)VCS_STATUS_TAG}
      (( $#tag > 32 )) && tag[13,-13]="…"
      res+="#${tag//\%/%%}"
    fi
    [[ -z $VCS_STATUS_LOCAL_BRANCH && -z $VCS_STATUS_TAG ]] && res+="@${VCS_STATUS_COMMIT[1,8]}"
    # The tracking branch when its name differs.
    [[ -n ${VCS_STATUS_REMOTE_BRANCH:#$VCS_STATUS_LOCAL_BRANCH} ]] &&
      res+=":${(V)VCS_STATUS_REMOTE_BRANCH//\%/%%}"
    [[ $VCS_STATUS_COMMIT_SUMMARY == (|*[^[:alnum:]])(wip|WIP)(|[^[:alnum:]]*) ]] && res+=" wip"

    (( VCS_STATUS_COMMITS_BEHIND )) && res+=" ⇣$VCS_STATUS_COMMITS_BEHIND"
    (( VCS_STATUS_COMMITS_AHEAD && !VCS_STATUS_COMMITS_BEHIND )) && res+=" "
    (( VCS_STATUS_COMMITS_AHEAD )) && res+="⇡$VCS_STATUS_COMMITS_AHEAD"
    (( VCS_STATUS_PUSH_COMMITS_BEHIND )) && res+=" ⇠$VCS_STATUS_PUSH_COMMITS_BEHIND"
    (( VCS_STATUS_PUSH_COMMITS_AHEAD && !VCS_STATUS_PUSH_COMMITS_BEHIND )) && res+=" "
    (( VCS_STATUS_PUSH_COMMITS_AHEAD )) && res+="⇢$VCS_STATUS_PUSH_COMMITS_AHEAD"
    (( VCS_STATUS_STASHES )) && res+=" *$VCS_STATUS_STASHES"
    [[ -n $VCS_STATUS_ACTION ]] && res+=" $alert$VCS_STATUS_ACTION$text"
    (( VCS_STATUS_NUM_CONFLICTED )) && res+=" $alert~$VCS_STATUS_NUM_CONFLICTED$text"
    (( VCS_STATUS_NUM_STAGED )) && res+=" +$VCS_STATUS_NUM_STAGED"
    (( VCS_STATUS_NUM_UNSTAGED )) && res+=" !$VCS_STATUS_NUM_UNSTAGED"
    (( VCS_STATUS_NUM_UNTRACKED )) &&
      res+=" ${(g::)POWERLEVEL9K_VCS_UNTRACKED_ICON}$VCS_STATUS_NUM_UNTRACKED"
    # "─": the unstaged count is unknown (bash.showDirtyState=false).
    (( VCS_STATUS_HAS_UNSTAGED == -1 )) && res+=" ─"

    typeset -g my_git_format=$res
  }
  functions -M my_git_formatter 2>/dev/null

  typeset -g POWERLEVEL9K_VCS_DISABLE_GITSTATUS_FORMATTING=true
  typeset -g POWERLEVEL9K_VCS_CONTENT_EXPANSION='${$((my_git_formatter(1)))+${my_git_format}}'
  typeset -g POWERLEVEL9K_VCS_LOADING_CONTENT_EXPANSION='${$((my_git_formatter(0)))+${my_git_format}}'
  # Count staged, unstaged, untracked, conflicted, ahead and behind in full.
  typeset -g POWERLEVEL9K_VCS_{STAGED,UNSTAGED,UNTRACKED,CONFLICTED,COMMITS_AHEAD,COMMITS_BEHIND}_MAX_NUM=-1
  typeset -g POWERLEVEL9K_VCS_MAX_INDEX_SIZE_DIRTY=-1
  # No git status for a repository whose work tree is $HOME itself.
  typeset -g POWERLEVEL9K_VCS_DISABLED_WORKDIR_PATTERN='~'
  typeset -g POWERLEVEL9K_VCS_BACKENDS=(git)

  ###################################[ status ]###################################
  # Plain exit codes stay hidden: a red ❯ already says the command failed.
  # Signals and failed pipelines show.
  typeset -g POWERLEVEL9K_STATUS_EXTENDED_STATES=true
  typeset -g POWERLEVEL9K_STATUS_OK=false
  typeset -g POWERLEVEL9K_STATUS_OK_PIPE=true
  typeset -g POWERLEVEL9K_STATUS_OK_PIPE_VISUAL_IDENTIFIER_EXPANSION='✔'
  typeset -g POWERLEVEL9K_STATUS_ERROR=false
  typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL=true
  typeset -g POWERLEVEL9K_STATUS_VERBOSE_SIGNAME=false
  typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL_VISUAL_IDENTIFIER_EXPANSION='✘'
  typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE=true
  typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE_VISUAL_IDENTIFIER_EXPANSION='✘'

  ###########################[ command_execution_time ]###########################
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_THRESHOLD=3
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_PRECISION=0
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FORMAT='d h m s'

  ##############################[ background_jobs ]###############################
  typeset -g POWERLEVEL9K_BACKGROUND_JOBS_VERBOSE=false

  #################################[ virtualenv ]#################################
  typeset -g POWERLEVEL9K_VIRTUALENV_SHOW_PYTHON_VERSION=false
  typeset -g POWERLEVEL9K_VIRTUALENV_SHOW_WITH_PYENV=false
  typeset -g POWERLEVEL9K_VIRTUALENV_{LEFT,RIGHT}_DELIMITER=

  ################################[ kubecontext ]#################################
  # Only while typing a command that talks to the cluster.
  typeset -g POWERLEVEL9K_KUBECONTEXT_SHOW_ON_COMMAND='kubectl|helm|kubens|kubectx|oc|istioctl|kogito|k9s|helmfile|flux|fluxctl|stern|kubeseal|skaffold|kubent|kubecolor|cmctl|sparkctl'
  # The cloud cluster name, else the context name; then /namespace unless "default".
  typeset -g POWERLEVEL9K_KUBECONTEXT_CONTENT_EXPANSION='${P9K_KUBECONTEXT_CLOUD_CLUSTER:-${P9K_KUBECONTEXT_NAME}}${${:-/$P9K_KUBECONTEXT_NAMESPACE}:#/default}'

  #################################[ terraform ]##################################
  typeset -g POWERLEVEL9K_TERRAFORM_SHOW_DEFAULT=false

  ####################################[ aws ]#####################################
  typeset -g POWERLEVEL9K_AWS_SHOW_ON_COMMAND='aws|awless|cdk|terraform|pulumi|terragrunt'
  typeset -g POWERLEVEL9K_AWS_CONTENT_EXPANSION='${P9K_AWS_PROFILE//\%/%%}${P9K_AWS_REGION:+ ${P9K_AWS_REGION//\%/%%}}'

  ##################################[ context ]###################################
  # user@host only as root or over SSH; bold as root.
  typeset -g POWERLEVEL9K_CONTEXT_TEMPLATE='%n@%m'
  typeset -g POWERLEVEL9K_CONTEXT_ROOT_TEMPLATE='%B%n@%m'
  typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}_{CONTENT,VISUAL_IDENTIFIER}_EXPANSION=

  ####################################[ time ]####################################
  typeset -g POWERLEVEL9K_TIME_FORMAT='%D{%H:%M:%S}'
  typeset -g POWERLEVEL9K_TIME_UPDATE_ON_COMMAND=false

  # If p10k is already loaded, reload configuration.
  # This works even with POWERLEVEL9K_DISABLE_HOT_RELOAD=true.
  (( ! $+functions[p10k] )) || p10k reload
}

# Tell `p10k configure` which file it should overwrite.
typeset -g POWERLEVEL9K_CONFIG_FILE=${${(%):-%x}:a}

(( ${#p10k_config_opts} )) && setopt ${p10k_config_opts[@]}
'builtin' 'unset' 'p10k_config_opts'
