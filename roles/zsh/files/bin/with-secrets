#!/usr/bin/env zsh
# Load 1Password env once, then replace this process with the command.
# Orca: with-secrets agent   |   with-secrets omp
# Opt out: ORCA_SKIP_SECRETS=1 or SECRET_SKIP=1

if (( $# == 0 )); then
  print -ru2 -- "Usage: with-secrets <command> [args...]"
  print -ru2 -- "For the current shell, run: secret"
  exit 2
fi

if [[ "${ORCA_SKIP_SECRETS:-}" == 1 || "${SECRET_SKIP:-}" == 1 ]]; then
  exec "$@"
fi

_secret_functions="${HOME}/.config/zsh/vars.secret_functions.zsh"
if [[ ! -r "$_secret_functions" ]]; then
  print -ru2 -- "Error: unable to load secrets"
  exit 1
fi

# Avoid installing interactive wrappers in this non-interactive launcher.
setopt no_interactive
source "$_secret_functions"
unset _secret_functions

if ! __secret_ensure_loaded; then
  print -ru2 -- "Error: unable to load secrets"
  exit 1
fi

exec "$@"
