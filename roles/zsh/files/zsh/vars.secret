#!/usr/bin/env zsh

MY_ACCOUNT="my.1password.com"

__secret_export_op_read OPENAI_API_KEY --account "$MY_ACCOUNT" "op://Redhorse/Redhorse OpenAI/API Keys/Initial" || return 1
__secret_export_op_read OTEL_EXPORTER_OTLP_API_KEY --account "$MY_ACCOUNT" "op://HomeLab/OpenMonitor/password" || return 1
if command -v tailscale >/dev/null 2>&1 && tailscale ip -4 >/dev/null 2>&1; then
  __secret_export_op_read OTEL_EXPORTER_OTLP_LOGS_ENDPOINT --account "$MY_ACCOUNT" "op://HomeLab/OpenMonitor/tailscale_url" || return 1
else
  __secret_export_op_read OTEL_EXPORTER_OTLP_LOGS_ENDPOINT --account "$MY_ACCOUNT" "op://HomeLab/OpenMonitor/local_url" || return 1
fi
export OTEL_EXPORTER_OTLP_ENDPOINT="$OTEL_EXPORTER_OTLP_LOGS_ENDPOINT"
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer $OTEL_EXPORTER_OTLP_API_KEY"
export OTEL_EXPORTER_OTLP_LOGS_HEADERS="$OTEL_EXPORTER_OTLP_HEADERS"
__secret_export_op_read GHP_USERNAME --account "$MY_ACCOUNT" "op://Personal/GitHub/username" || return 1
__secret_export_op_read GHP_SECRET --account "$MY_ACCOUNT" "op://Personal/GitHub/token_write-packages" || return 1
__secret_export_op_read GITHUB_TOKEN --account "$MY_ACCOUNT" "op://Personal/GitHub/token" || return 1

# AWS credentials.
# Use env credentials instead of the default AWS_PROFILE from vars.zsh.
AWS_CREDS_ITEM="$(__secret_op_read --account "$MY_ACCOUNT" "op://Redhorse/AWS/secret_name")" || return 1
unset AWS_PROFILE AWS_DEFAULT_PROFILE
__secret_export_op_read AWS_ACCESS_KEY_ID --account "$MY_ACCOUNT" "op://Redhorse/${AWS_CREDS_ITEM}/Creds/access_key_id" || return 1
__secret_export_op_read AWS_SECRET_ACCESS_KEY --account "$MY_ACCOUNT" "op://Redhorse/${AWS_CREDS_ITEM}/Creds/secret_access_key" || return 1
__secret_export_op_read AWS_ACCOUNT_ID --account "$MY_ACCOUNT" "op://Redhorse/${AWS_CREDS_ITEM}/Creds/account_id" || return 1
__secret_export_op_read AWS_REGION --account "$MY_ACCOUNT" "op://Redhorse/${AWS_CREDS_ITEM}/Creds/region" || return 1
export AWS_DEFAULT_REGION="$AWS_REGION"
export AWS_PAGER=""
unset AWS_CREDS_ITEM
